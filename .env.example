# ==============================================================================
# Emergency Medical Report Parser & Authorized Specialist Matchmaking Network
# Environment & Supabase Database Configuration
# ==============================================================================

# 1. Supabase PostgreSQL Direct Database Connection (Recommended)
# Find this in your Supabase Dashboard:
# Project Settings -> Database -> Connection string -> URI
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or (Connection Pooling): postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 2. Supabase API Credentials (Optional / Future Auth & Storage)
# Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 3. Server Port
PORT=3000

